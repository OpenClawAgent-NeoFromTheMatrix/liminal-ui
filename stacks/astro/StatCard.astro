---
interface Props { label: string; value: string; subtitle?: string; }
const { label, value, subtitle } = Astro.props;
---
<div class="glass-card" style="padding:var(--space-sm)">
  <div style="font-size:var(--text-xs);color:var(--text-muted)">{label}</div>
  <div style="font-size:var(--text-xl);font-weight:700">{value}</div>
  {subtitle && <div style="font-size:var(--text-2xs);color:var(--text-muted)">{subtitle}</div>}
</div>
