{
  "families": {
    "sans": "'Inter', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'Fira Code', monospace"
  },
  "roles": {
    "heading-1": {
      "family": "sans",
      "size": 24,
      "weight": 600,
      "leading": 1.2
    },
    "heading-2": {
      "family": "sans",
      "size": 18,
      "weight": 600,
      "leading": 1.3
    },
    "heading-3": {
      "family": "sans",
      "size": 14,
      "weight": 600,
      "leading": 1.4
    },
    "body": {
      "family": "sans",
      "size": 14,
      "weight": 400,
      "leading": 1.6
    },
    "body-small": {
      "family": "sans",
      "size": 12,
      "weight": 400,
      "leading": 1.5
    },
    "label": {
      "family": "sans",
      "size": 11,
      "weight": 500,
      "leading": 1,
      "transform": "uppercase",
      "tracking": "wider"
    },
    "stat-value": {
      "family": "mono",
      "size": 24,
      "weight": 600,
      "leading": 1
    },
    "code": {
      "family": "mono",
      "size": 13,
      "weight": 400,
      "leading": 1.5
    },
    "caption": {
      "family": "mono",
      "size": 11,
      "weight": 400,
      "leading": 1.4
    },
    "text-2xs": {
      "family": "sans",
      "size": 11,
      "weight": 400,
      "leading": 1.4
    }
  }
}